# Token do bot, gerado pelo @BotFather
TELEGRAM_TOKEN=123456789:SEU-TOKEN

# Pessoas cadastradas, no formato id:nome:papel, separadas por vírgula. Papéis: admin, membro.
# O nome deve ser igual ao que aparece na planilha. Para descobrir um ID, fale com o @userinfobot.
USERS=111111111:Ana:admin,222222222:Bruno:membro,333333333:Carla:membro

# Planilha da escala (o ID fica na URL: docs.google.com/spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=SEU-ID-DA-PLANILHA
SCHEDULE_RANGE=Escala!A2:F10
# Opcional: intervalo com os nomes dos gestores (habilita o comando /gestores)
MANAGERS_RANGE=

# Credenciais do Google (OAuth do tipo Desktop). O token.json é criado na primeira execução.
GOOGLE_CLIENT_SECRET_FILE=secrets/client_secret.json
GOOGLE_TOKEN_FILE=secrets/token.json

# Turnos da escala: CODIGO=início, separados por vírgula, e o fim do último turno.
# O código deve ser igual ao da primeira coluna da planilha. Também pode ser usado no pedido (agendar amanhã T34 ...).
SLOTS=M12=07:00,M34=08:55,M56=10:50,T12=13:00,T34=14:55,T56=16:50,N12=18:45,N34=20:35
SLOTS_END=22:15

# Períodos sem agendamento, todo ano: dd/mm-dd/mm=rótulo, separados por ponto e vírgula.
CLOSED_PERIODS=22/12-14/01=recesso
TIMEZONE=America/Sao_Paulo

# Textos exibidos pelo bot
BOT_NAME=Bot de Plantão
ABOUT_TEXT=Bot de plantão da equipe.\nMais informações: https://exemplo.com
URGENT_CONTACT=

# Opcionais
PENDING_REQUESTS_FILE=data/pending_requests.json
SCHEDULE_IMAGES_DIR=assets/escalas
# Encaminha ao admin todas as mensagens recebidas. Avise os usuários antes de ativar.
FORWARD_MESSAGES_TO_ADMIN=false
